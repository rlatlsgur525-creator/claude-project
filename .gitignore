# 컴퓨터별 Claude 설정
.claude/settings.local.json

# 비밀 정보
.env
.env.*

# OS / 에디터
Thumbs.db
desktop.ini
.DS_Store
.vscode/

# 촬영 원본·렌더 영상 (용량이 커서 GitHub에 올리지 않음)
*.mp4
*.mov
# 단, 홈페이지 히어로 영상(작은 웹용 파일)은 올림
!fp-site/assets/*.mp4

# 의존성·빌드 결과
node_modules/
__pycache__/
.venv/
dist/
build/

# 스튜디오가 렌더할 때마다 다시 만드는 파일
miracle-shorts/studio/projects/*/edl.json
miracle-shorts/studio/projects/*/wave_*.json
miracle-shorts/studio/projects/*/render.json
miracle-shorts/studio/music/
miracle-shorts/studio/projects/*/scenes_*/
miracle-shorts/studio/projects/*/thumbnail.png
miracle-shorts/studio/projects/*/media/*.wav
miracle-shorts/studio/projects/*/media/*.webm

# 마스코트 동작 클립(초록 배경, 각 2MB 안팎)은 다른 컴퓨터에서도 써야 하므로 올린다
!miracle-shorts/studio/library/anim/*.mp4
miracle-shorts/studio/projects/*/mascot_*.mp4.key
miracle-shorts/studio/projects/*/thumbs/
