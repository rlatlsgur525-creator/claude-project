# 촬영 원본·렌더 영상 (용량이 커서 GitHub에 올리지 않음)
*.mp4
*.mov
# 단, 홈페이지 히어로 영상(작은 웹용 파일)은 올림
!fp-site/assets/*.mp4

# 의존성·빌드 결과
node_modules/
__pycache__/
.venv/
dist/
build/

